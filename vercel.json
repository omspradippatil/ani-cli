{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://om-cli-anime.omspradippatil.workers.dev/api/$1"
    },
    {
      "source": "/download/tv-apk",
      "destination": "/website/ani-cli-production-signed.apk"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/website/public/$1"
    }
  ]
}
