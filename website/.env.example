# ==============================================================================
# Om CLI Anime Platform — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Cloudflare D1 (Serverless SQLite) Configuration
# ------------------------------------------------------------------------------
# If set, the server connects directly to your live Cloudflare D1 SQLite database.
# If omitted, the server automatically uses local native SQLite (data/kuronami.db).
#
# Steps to obtain Cloudflare D1 credentials:
# 1. Run: npx wrangler d1 create omcli-db
# 2. Copy the database_id into CLOUDFLARE_DATABASE_ID and wrangler.toml
# 3. Get your Account ID from Cloudflare Dashboard (Workers & Pages sidebar)
# 4. Create an API Token with "D1:Edit" permission at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# Optional External Video Proxy (Bandwidth Offloader)
# ------------------------------------------------------------------------------
# Leave empty to use the built-in high-performance proxy (/api/proxy/*)
STREAM_PROXY_URL=
